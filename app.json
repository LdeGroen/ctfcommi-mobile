{
  "expo": {
    "name": "CTF Commi",
    "slug": "ctfcommi",
    "scheme": "commi",
    "version": "0.1.17",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#396971",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "ios": {
      "bundleIdentifier": "nl.cafetheaterfestival.commi",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nl.cafetheaterfestival.commi",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#396971"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#396971"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugins/withFmtConstevalFix",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/feather.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://backend.cafetheaterfestival.nl",
      "webUrl": "https://commi.cafetheaterfestival.nl",
      "pusherKey": "2f06adeb85a0b8f40462",
      "pusherCluster": "eu",
      "eas": {
        "projectId": "9232f4e2-a1d1-4899-b897-4953a05d9750"
      }
    },
    "owner": "lucdeg"
  }
}
